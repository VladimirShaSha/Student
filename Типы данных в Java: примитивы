
public class Main {
    public static void main(String[] args) {
        int earnings = 0; // доход
        int spendings = 0; //расход
        String earningsInput; //Ввод дохода
        String spendingsInput; //Ввод расхода
        java.util.Scanner scanner = new java.util.Scanner(System.in);
        while (true) {
            System.out.print("Добавить новый доход ");
            earningsInput = scanner.nextLine();
            if (earningsInput.equals("Выбрать систему налогообложения")) {
                break;
            } else {
                earnings += Integer.parseInt(earningsInput);
            }
            System.out.print("Добавить новый расход ");
            spendingsInput = scanner.nextLine();
            if (spendingsInput.equals("Выбрать систему налогообложения")) {
                break;
            } else {
                spendings += Integer.parseInt(spendingsInput);
            }
        }
        int resultUsnSpendings = TaxCalculator.calculateUsnSpendings(earnings, spendings);
        int resultUsn = TaxCalculator.calculateUsn(earnings);
        if (resultUsnSpendings < resultUsn) {
            int savings = resultUsn - resultUsnSpendings;
            System.out.println("Мы советуем вам УСН доходы минус расходы");
            System.out.println("Ваш налог составит: " + resultUsnSpendings + " рублей");
            System.out.println("Налог на другой системе: " + resultUsn + " рублей");
            System.out.println("Экономия: " + savings + " рублей");
        } else {
            int savings = resultUsnSpendings - resultUsn;
            System.out.println("Мы советуем вам УСН доходы");
            System.out.println("Ваш налог составит: " + resultUsn + " рублей");
            System.out.println("Налог на другой системе: " + resultUsnSpendings + " рублей");
            System.out.println("Экономия: " + savings + " рублей");
        }
    }


    public static class TaxCalculator {
        public static int calculateUsnSpendings(int earnings, int spendings) {
            int tax = (earnings - spendings) * 15 / 100;
                return (tax >= 0) ? tax : 0;
        }

        public static int calculateUsn(int earnings) {
            int tax = earnings * 6 / 100;
            return (tax >= 0) ? tax : 0;
        }
    }
}
